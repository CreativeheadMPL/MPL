# Motion Pulse Sample Space Environment Configuration

# Server Port and URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Authentication
ADMIN_EMAIL=admin@motionpulse.local
ADMIN_PASSWORD=motionpulse-demo
SESSION_SECRET=dev-secret-replace-with-cryptographically-secure-random-key-in-production

# Supabase PostgreSQL Database Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Audio Playback
# Audio samples stream from Google Drive share links. Ensure drive files are set to "Anyone with the link".
