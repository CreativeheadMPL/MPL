# Motion Pulse Sample Space Environment Configuration

# Server Port and URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Authentication (Development Default)
ADMIN_EMAIL=admin@motionpulse.local
ADMIN_PASSWORD=motionpulse-demo
SESSION_SECRET=dev-secret-replace-with-cryptographically-secure-random-key-in-production

# Audio Storage Provider ('local' | 'r2' | 's3')
AUDIO_STORAGE_PROVIDER=local

# Local Storage Configuration
LOCAL_STORAGE_DIR=storage/audio

# Optional: Cloudflare R2 / AWS S3 Configuration (for production deployment)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=motion-pulse-samples
# S3_REGION=auto
# S3_SIGNED_URL_EXPIRATION=3600
